{
    "name": "prieboj/prio-widget",
    "description": "Android home-screen widget for Prio Notes: shows what is most urgent right now",
    "type": "nativephp-plugin",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Prieboj\\PrioWidget\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Prieboj\\PrioWidget\\PrioWidgetServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    }
}
